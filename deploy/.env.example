# --- domains (Caddy issues HTTPS certificates automatically) ---
APP_DOMAIN=press.example.ge
SUPABASE_DOMAIN=api.press.example.ge
APP_URL=https://press.example.ge

# --- Supabase (from supabase/docker/.env) ---
NEXT_PUBLIC_SUPABASE_URL=https://api.press.example.ge
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# random string: openssl rand -hex 24
CRON_SECRET=

# --- email (any SMTP: Gmail/Workspace, Mailgun, Brevo...) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="პრეს ცენტრი <press@example.ge>"

# --- SMS: smsoffice | twilio | log | (empty = off) ---
SMS_PROVIDER=
SMS_SENDER=
SMSOFFICE_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- WhatsApp Cloud API (empty = off) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=press_shoot
WHATSAPP_TEMPLATE_LANG=ka

# --- Telegram (empty = off) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# --- Google Maps travel time (empty = manual entry only) ---
GOOGLE_MAPS_API_KEY=
# press center address or "lat,lng"
PRESS_CENTER_ORIGIN=
